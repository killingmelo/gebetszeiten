<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy by construction: NO INTERNET permission and NO location
      permission. The app can neither phone home nor track the user. Prayer
      times are computed entirely offline from manually entered coordinates.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: Restzeit als Live-Update-Feld in der Statusleiste (normale Berechtigung, kein Dialog). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Lets the user exempt the app from battery optimization via a single
         dialog, so OEM power managers don't swallow the exact alarms. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Aḏān-Wiedergabe als Vordergrunddienst (nur wenn der Nutzer sie einschaltet). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Pulled in transitively by Glance/WorkManager; we never touch the
         network, so remove it to keep the permission set minimal. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gebetszeiten">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home + lock screen widget (single Glance widget). -->
        <receiver
            android:name=".widget.NextPrayerWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_prayer_widget_info" />
        </receiver>

        <!-- Einstellungen je Widget: beim Hinzufügen und über „Widget bearbeiten“. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Gebetszeiten">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Fires at each prayer time: posts the notification, advances the
             widget, schedules the next exact alarm. -->
        <receiver
            android:name=".alarm.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Spielt den Aḏān zur Gebetszeit; gestartet vom PrayerAlarmReceiver. -->
        <service
            android:name=".adhan.AdhanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Reschedules alarms after reboot / app update / time / timezone
             changes (Android clears all alarms in each of these cases). -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
